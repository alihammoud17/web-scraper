<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Infrastructure and Infrastructure.Browser are referenced only so the architecture tests
       can load those assemblies; no test exercises them directly. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Scraper.Application\Scraper.Application.csproj" />
    <ProjectReference Include="..\..\src\Scraper.Infrastructure\Scraper.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Scraper.Infrastructure.Browser\Scraper.Infrastructure.Browser.csproj" />
  </ItemGroup>

</Project>