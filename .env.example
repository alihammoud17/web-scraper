# Copy to .env and replace every value. .env is git-ignored; never commit real secrets.

# PostgreSQL
POSTGRES_DB=scraper
POSTGRES_USER=scraper
POSTGRES_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USER=scraper
RABBITMQ_PASSWORD=change-me

# Auth (used from the auth milestone on). Use at least 32 random characters.
JWT_SIGNING_KEY=change-me-to-a-random-string-of-at-least-32-characters
SEED_ADMIN_PASSWORD=change-me
SEED_VIEWER_PASSWORD=change-me

# Crawler: identify the bot and give site owners a way to reach you.
CRAWLER_USER_AGENT=DistributedScraperBot/1.0 (+mailto:you@example.com)

# Optional proof/demo mode: when set, every worker fetches this URL in a loop through the full polite
# pipeline. Leave empty normally. Example: http://testsite:8080/pages/1 (see README, Manual testing).
CRAWLER_PROBE_URL=
